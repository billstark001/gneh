{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "ignorePatterns": [
    "**/dist/**",
    "standalone/**",
    "examples/playground/site/**"
  ],
  "rules": {
    "@stylistic/max-len": [
      "error",
      {
        "code": 120,
        "tabWidth": 2,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": { "selector": "Program > ImportDeclaration" },
        "next": { "selector": "Program > *" }
      },
      {
        "blankLine": "any",
        "prev": { "selector": "Program > ImportDeclaration" },
        "next": { "selector": "Program > ImportDeclaration" }
      },
      {
        "blankLine": "always",
        "prev": {
          "selector": "Program > :matches(FunctionDeclaration, ClassDeclaration, TSInterfaceDeclaration, TSTypeAliasDeclaration, TSEnumDeclaration, TSDeclareFunction, ExportNamedDeclaration[declaration.type=/^(?:FunctionDeclaration|ClassDeclaration|TSInterfaceDeclaration|TSTypeAliasDeclaration|TSEnumDeclaration|TSDeclareFunction)$/], ExportDefaultDeclaration[declaration.type=/^(?:FunctionDeclaration|ClassDeclaration)$/])"
        },
        "next": { "selector": "Program > *" }
      },
      {
        "blankLine": "always",
        "prev": { "selector": "Program > *" },
        "next": {
          "selector": "Program > :matches(FunctionDeclaration, ClassDeclaration, TSInterfaceDeclaration, TSTypeAliasDeclaration, TSEnumDeclaration, TSDeclareFunction, ExportNamedDeclaration[declaration.type=/^(?:FunctionDeclaration|ClassDeclaration|TSInterfaceDeclaration|TSTypeAliasDeclaration|TSEnumDeclaration|TSDeclareFunction)$/], ExportDefaultDeclaration[declaration.type=/^(?:FunctionDeclaration|ClassDeclaration)$/])"
        }
      }
    ],
    "max-lines": ["error", { "max": 300, "skipBlankLines": false, "skipComments": false }],
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/karlowe/src/parser.ts",
        "packages/sugarcast/src/parser.ts",
        "packages/syntax/src/parser.ts"
      ],
      "rules": { "max-lines": ["error", { "max": 750 }] }
    },
    {
      "files": ["packages/runtime/src/story.ts"],
      "rules": { "max-lines": ["error", { "max": 650 }] }
    },
    {
      "files": [
        "packages/core/src/evaluate.ts",
        "packages/expression/src/parser.ts",
        "packages/language-service/src/service.ts",
        "packages/renderer-dom/src/renderer.ts",
        "packages/compiler/src/project.ts",
        "scripts/audit-twine-html.mjs"
      ],
      "rules": { "max-lines": ["error", { "max": 450 }] }
    },
    {
      "files": ["packages/compiler/test/languages.test.ts"],
      "rules": { "max-lines": ["error", { "max": 500 }] }
    }
  ]
}
