{
  "name": "@gneh/vendor",
  "version": "0.1.0",
  "description": "Source/IR vendor loader and optional dynamic wikification",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@gneh/compiler": "workspace:*",
    "@gneh/core": "workspace:*",
    "@gneh/renderer-dom": "workspace:*",
    "@gneh/runtime": "workspace:*"
  }
}
